export RSTUDIO_VERSION_MAJOR=2026
export RSTUDIO_VERSION_MINOR=09
export RSTUDIO_VERSION_PATCH=0
export RSTUDIO_VERSION_SUFFIX=+174
export RSTUDIO_VERSION="${version}"
export PACKAGE_OS=VoidLinux
export JAVA_HOME=/usr/lib/jvm/openjdk17
export ELECTRON_SKIP_BINARY_DOWNLOAD=1
export ELECTRON_OVERRIDE_DIST_PATH=/usr/lib/electron42
export RSTUDIO_ELECTRON_VERSION="${_electronver}"
export npm_config_nodedir=/usr/include/electron42/node_headers
export npm_config_build_from_source=true
export npm_config_audit=false
export npm_config_fund=false

post_extract() {
	cp "${FILESDIR}/prepare-desktop.cjs" src/node/desktop/scripts/void-prepare.cjs
	mkdir -p dependencies/dictionaries dependencies/common/gwtproject
	unzip -qd dependencies/dictionaries \
		"${XBPS_SRCDISTDIR}/${pkgname}-${version}/core-dictionaries.zip"
	vsrcextract --no-strip-components -C dependencies/common/gwtproject \
		"gwt-${_gwtrelease}.tar.gz"
	mkdir -p src/gwt/lib/quarto
	vsrcextract --strip-components=1 -C src/gwt/lib/quarto \
		"panmirror-${_panmirrorrev}.tar.gz"
	mkdir -p dependencies/vendor/dtl
	vsrcextract --strip-components=1 -C dependencies/vendor/dtl \
		"dtl-32567bb9ec704f09040fb1ed7431a3d967e3df03.tar.gz"
	mkdir -p dependencies/vendor/gsl-lite
	vsrcextract --strip-components=1 -C dependencies/vendor/gsl-lite \
		"gsl_lite-21751fb0473473e27ffb1f280543885ed65447a8.tar.gz"
	mkdir -p dependencies/vendor/gtest
	vsrcextract --strip-components=1 -C dependencies/vendor/gtest \
		"gtest-52eb8108c5bdec04579160ae17225d66034bd723.tar.gz"
	mkdir -p dependencies/vendor/rapidjson
	vsrcextract --strip-components=1 -C dependencies/vendor/rapidjson \
		"rapidjson-24b5e7a8b27f42fa16b96fc70aade9106cf7102f.tar.gz"
	mkdir -p dependencies/vendor/tl-expected
	vsrcextract --strip-components=1 -C dependencies/vendor/tl-expected \
		"tl_expected-292eff8bd8ee230a7df1d6a1c00c4ea0eb2f0362.tar.gz"
	mkdir -p dependencies/vendor/utfcpp
	vsrcextract --strip-components=1 -C dependencies/vendor/utfcpp \
		"utfcpp-f9319195dfddf369f68f18e7c0039b3f351797fd.tar.gz"
	mkdir -p dependencies/vendor/websocketpp
	vsrcextract --strip-components=1 -C dependencies/vendor/websocketpp \
		"websocketpp-ee8cf4257e001d939839cff5b1766a835b749cd6.tar.gz"
}

pre_configure() {
	local dep
	for dep in dtl gsl-lite gtest rapidjson tl-expected utfcpp websocketpp; do
		configure_args+=" -DFETCHCONTENT_SOURCE_DIR_${dep^^}=${wrksrc}/dependencies/vendor/${dep}"
	done
	export npm_config_cache="${wrksrc}/.npm-cache"
	export YARN_CACHE_FOLDER="${wrksrc}/.yarn-cache"
	export RSTUDIO_ELECTRON_ZIP_DIR="${wrksrc}/electron-dist"
	mkdir -p "${RSTUDIO_ELECTRON_ZIP_DIR}"
	if [ ! -f "${RSTUDIO_ELECTRON_ZIP_DIR}/electron-v${_electronver}-linux-x64.zip" ]; then
		(cd /usr/lib/electron42 && zip -qr \
			"${RSTUDIO_ELECTRON_ZIP_DIR}/electron-v${_electronver}-linux-x64.zip" .)
	fi
	ln -sfn /usr/share/mathjax dependencies/mathjax-27
	ln -sfn /usr/share/mathjax4 dependencies/mathjax-4
	mkdir -p dependencies/pandoc/3.2
	ln -sfn /usr/bin/pandoc dependencies/pandoc/3.2/pandoc
	mkdir -p dependencies/common/node/22.23.2-installed/bin
	ln -sfn /usr/bin/node dependencies/common/node/22.23.2-installed/bin/node
	# Acquire lockfile-pinned dependencies once; the Ant build uses the cache offline.
	(cd src/gwt/lib/quarto && yarn install --frozen-lockfile --ignore-scripts --non-interactive)
}

post_configure() {
	cd src/node/desktop-build-x86_64
	node "${FILESDIR}/prepare-desktop.cjs"
	npm ci --ignore-scripts
	npm exec --offline -- ts-node scripts/generate.ts
	npm exec --offline -- node-gyp rebuild --target="${_electronver}" \
		--nodedir="${npm_config_nodedir}"
	npm exec --offline -- electron-rebuild --force --build-from-source --version "${_electronver}"
}

pre_build() {
	export npm_config_cache="${wrksrc}/.npm-cache"
	export YARN_CACHE_FOLDER="${wrksrc}/.yarn-cache"
	export RSTUDIO_ELECTRON_ZIP_DIR="${wrksrc}/electron-dist"
	export npm_config_offline=true
}

do_check() {
	# Upstream only enables CTest in these subdirectories, not at the root.
	ctest --test-dir build/src/cpp/shared_core --output-on-failure
	ctest --test-dir build/src/cpp/core --output-on-failure
	(cd src/node/desktop-build-x86_64 && npm run typecheck)
	(cd src/node/desktop-build-x86_64 && ELECTRON_RUN_AS_NODE=1 \
		electron42 "${FILESDIR}/check-addons.cjs")
}

post_install() {
	vbin "${FILESDIR}/rstudio"
	local helper
	for helper in diagnostics rpostback rsession; do
		ln -s ../lib/rstudio/resources/app/bin/${helper} "${DESTDIR}/usr/bin/${helper}"
	done
	vlicense COPYING
}
