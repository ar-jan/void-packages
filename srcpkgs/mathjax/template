# Template file for 'mathjax'
pkgname=mathjax
version=4.1.3
revision=1
create_wrksrc=yes
short_desc="JavaScript display engine for LaTeX, MathML and AsciiMath"
maintainer="Orphaned <orphan@voidlinux.org>"
license="Apache-2.0"
homepage="https://www.mathjax.org/"
distfiles="https://registry.npmjs.org/mathjax/-/mathjax-${version}.tgz
 https://registry.npmjs.org/@mathjax/mathjax-newcm-font/-/mathjax-newcm-font-${version}.tgz"
checksum="b7109f516f3d842de62b95d653e35fa0976dc223706a2a77440e7f7723f0c54d
 87d7b869c6a2a6169d9a53acc4eab6c846a9cbe11752738226461bb5070c8b88"
skip_extraction="mathjax-newcm-font-${version}.tgz"

post_extract() {
	mkdir -p package/fonts/mathjax-newcm-font
	vsrcextract -C package/fonts/mathjax-newcm-font --strip-components=1 \
		"mathjax-newcm-font-${version}.tgz"
}

do_install() {
	vmkdir usr/share/mathjax4
	vcopy "package/*" usr/share/mathjax4
}
