nocross=yes
lib32disabled=yes
# Bundled graphics libraries are private to this browser.
noshlibprovides=yes
make_check=no # Browser integration tests need a graphical session and a sandbox.

build_options="debug vaapi pulseaudio pipewire qt6 lto"
build_options_default="vaapi pulseaudio pipewire qt6"
desc_option_debug="Build with debug symbols"
desc_option_pipewire="Enable screen sharing for WebRTC via PipeWire"
desc_option_lto="Enable Link Time Optimization"

subpackages="" # xbps-src does not reset the variable.
if [ "$build_option_qt6" ]; then
	subpackages+=" brave-browser-qt6"
fi

_setup_toolchain() {
	export CC=clang CXX=clang++ AR=llvm-ar NM=llvm-nm
	export BUILD_CC=clang BUILD_CXX=clang++ BUILD_AR=llvm-ar BUILD_NM=llvm-nm
	export CFLAGS="-Wno-unknown-warning-option -fdebug-prefix-map=$wrksrc=."
	export CXXFLAGS="$CFLAGS" BUILD_CFLAGS="-Wno-unknown-warning-option"
	export BUILD_CXXFLAGS="$BUILD_CFLAGS" LDFLAGS=""
	export RUSTC_BOOTSTRAP=1 CARGO_NET_OFFLINE=true
	export CARGO_HOME="$wrksrc/.cargo-home"
	export CARGO_BUILD_JOBS="$XBPS_MAKEJOBS"
	export CMAKE_BUILD_PARALLEL_LEVEL="$XBPS_MAKEJOBS"
	export npm_config_pm_on_fail=error
	export ESBUILD_BINARY_PATH=/usr/bin/esbuild
	export PYTHONPATH="$wrksrc/src/brave/script"
	export PYTHONPATH="$PYTHONPATH:$wrksrc/src/tools/grit/grit/extern"
	export PYTHONPATH="$PYTHONPATH:$wrksrc/src/brave/vendor/requests"
	export PYTHONPATH="$PYTHONPATH:$wrksrc/src/build:$wrksrc/src/third_party/depot_tools"
	export PYTHONUNBUFFERED=1 TARGET_ARCH=x64
}

do_extract() {
	# Preserve complete archives and extracted trees when dependency preparation
	# is interrupted. No gclient hooks or downloaded compiler toolchains run.
	local archive destination
	mkdir -p .extracted
	while read -r archive destination; do
		archive="${archive//@VERSION@/$version}"
		if [ ! -f ".extracted/$archive" ]; then
			mkdir -p "$destination"
			vsrcextract -C "$destination" "$archive"
			touch ".extracted/$archive"
		fi
	done <"${FILESDIR}/source-layout"
}

post_extract() {
	export ESBUILD_BINARY_PATH=/usr/bin/esbuild
	export npm_config_cache="${XBPS_HOSTDIR}/npm-cache"
	export npm_config_pm_on_fail=error
	# pnpm verifies the dependency integrities in the frozen upstream lockfiles.
	# Keep its store outside /tmp so interrupted downloads can be resumed.
	local project
	for project in src/brave src/brave/vendor/web-discovery-project; do
		(
			cd "$project"
			pnpm install --frozen-lockfile --yes --pm-on-fail=error \
				--store-dir "${XBPS_HOSTDIR}/pnpm-store"
		)
	done
}

do_patch() {
	python3 "${FILESDIR}/prepare-source.py" "$wrksrc/src" \
		"${FILESDIR}/chromium-patches" --brave-version "$version"
}

post_patch() {
	cd "$wrksrc/src"
	vsed -i 's,^update_readme$,#update_readme,' third_party/libvpx/generate_gni.sh
	vsed -i 's/OFFICIAL_BUILD/GOOGLE_CHROME_BUILD/' \
		tools/generate_shim_headers/generate_shim_headers.py

	# Both Chromium and Brave have build actions naming these paths directly.
	local target
	for target in third_party/node/linux/node-linux-x64/bin/node \
		brave/third_party/node/node-linux-x64/bin/node; do
		mkdir -p "${target%/*}"
		ln -sf /usr/bin/node "$target"
	done
	mkdir -p third_party/dawn/tools/golang/linux-amd64/bin
	ln -sf /usr/bin/go third_party/dawn/tools/golang/linux-amd64/bin/go
	mkdir -p third_party/gperf/cipd/bin
	ln -sf /usr/bin/gperf third_party/gperf/cipd/bin/gperf
	mkdir -p third_party/rust-toolchain/bin third_party/rust-toolchain/lib
	for target in cargo rustc rustfmt; do
		ln -sf "/usr/bin/$target" "third_party/rust-toolchain/bin/$target"
	done
	ln -sfn /usr/lib/rustlib third_party/rust-toolchain/lib/rustlib
	mkdir -p third_party/devtools-frontend/src/third_party/esbuild
	ln -sf /usr/bin/esbuild third_party/devtools-frontend/src/third_party/esbuild/esbuild
	# Chromium's tarball includes its JS build dependencies; replace esbuild.
	rm -rf third_party/devtools-frontend/src/node_modules/esbuild
	ln -s /usr/lib/node_modules/esbuild third_party/devtools-frontend/src/node_modules/esbuild
	ln -sf /usr/bin/gn buildtools/linux64/gn
}

do_configure() {
	_setup_toolchain
	local system=(flac fontconfig freetype libdrm libjpeg libwebp libxml libxslt opus)
	local conf=() clang_version="$(clang -dumpversion)"
	mkdir -p brave/tools/void
	cp "${FILESDIR}/redirect-cc.py" brave/tools/void/

	build/linux/unbundle/replace_gn_files.py --system-libraries "${system[@]}"
	third_party/libaddressinput/chromium/tools/update-strings.py
	(
		cd brave
		# Only prepare branding; do not run sync, hooks, or autoninja.
		node --input-type=module <<-'EOF'
			import config from './build/commands/lib/config.ts'
			import branding from './build/commands/lib/branding.js'
			config.update({build_config: 'Release', channel: 'release'})
			branding.update();
		EOF
		# The branding helper otherwise uses development artwork for community builds.
		cp node_modules/@brave/leo/icons/brave-icon-release-color.svg \
			../ui/webui/resources/images/chrome_logo_dark.svg
		python3 script/generate_licenses.py
	)
	mkdir -p out/Release
	cat >out/Release/args.gn <<-EOF
		import("//brave/build/args/brave_defaults.gni")
		import("//brave/build/args/blink_platform_defaults.gni")
		import("//brave/build/args/branding_defaults.gni")
		import("//brave/build/args/desktop_defaults.gni")
	EOF
	conf=(
		'target_cpu="x64"'
		'use_sysroot=false'
		'host_pkg_config="/usr/bin/pkg-config"'
		'is_clang=true'
		'use_lld=true'
		'clang_use_chrome_plugins=false'
		'clang_base_path="/usr"'
		"clang_cross_path=\"/usr/lib/llvm/${_llvmver}\""
		"clang_version=\"${clang_version%%.*}\""
		'use_clang_modules=false'
		'cc_wrapper="python3 ../../brave/tools/void/redirect-cc.py"'
		'use_custom_libcxx=true'
		'enable_rust=true'
		'rust_sysroot_absolute="/usr"'
		'rust_cross_sysroot_absolute="/usr"'
		'rust_bindgen_root="/usr"'
		"rustc_version=\"$(rustc --version | cut -d' ' -f2)\""
		'node_version_check=false'
		# Match Void Chromium and avoid metagen's bundled libclang binary.
		'v8_use_metagen_instance_types=false'
		'is_debug=false'
		'is_component_build=false'
		# Release optimization without Brave's private service credentials.
		'is_official_build=false'
		'dcheck_always_on=false'
		'brave_channel=""'
		'enable_updater=false'
		'enable_update_notifications=false'
		'use_remoteexec=false'
		'use_siso=false'
		"blink_symbol_level=$(vopt_if debug 1 0)"
		"symbol_level=$(vopt_if debug 1 0)"
		'icu_use_data_file=true'
		'use_system_harfbuzz=false'
		'use_system_libffi=true'
		'use_qt5=false'
		"use_qt6=$(vopt_if qt6 true false)"
		'use_cups=true'
		"use_vaapi=$(vopt_if vaapi true false)"
		"use_pulseaudio=$(vopt_if pulseaudio true false)"
		"link_pulseaudio=$(vopt_if pulseaudio true false)"
		"rtc_use_pipewire=$(vopt_if pipewire true false)"
		'treat_warnings_as_errors=false'
		'fatal_linker_warnings=false'
		'is_cfi=false'
		'use_cfi_icall=false'
		"use_thin_lto=$(vopt_if lto true false)"
		'chrome_pgo_phase=0'
		'custom_toolchain="//build/toolchain/linux/unbundle:default"'
		'host_toolchain="//build/toolchain/linux/unbundle:default"'
	)
	if [ "$build_option_qt6" ]; then
		conf+=('moc_qt6_path="/usr/lib/qt6/libexec"')
	fi
	printf '%s\n' "${conf[@]}" >>out/Release/args.gn
	gn gen out/Release
}

do_build() {
	_setup_toolchain
	# Exercise Brave's additional build systems before the large browser link.
	ninja -C out/Release ${makejobs} \
		obj/base/base/print_rust_log_ffi.o \
		gen/brave/web-discovery-project/core/content-script.bundle.js \
		gen/brave/components/brave_account/resources/opaque_ke/bundler/pkg/index_bg.wasm
	CCACHE_SLOPPINESS=include_file_mtime ninja -C out/Release ${makejobs} \
		brave:brave chrome_crashpad_handler
}

do_install() {
	local target size
	vinstall out/Release/brave 755 usr/lib/brave-browser
	vinstall out/Release/brave_sandbox 4755 usr/lib/brave-browser chrome-sandbox
	vinstall out/Release/chrome_crashpad_handler 755 usr/lib/brave-browser
	# ANGLE loads its matching Vulkan loader from the browser directory.
	for target in libEGL.so libGLESv2.so libvk_swiftshader.so libvulkan.so.1; do
		vinstall "out/Release/$target" 755 usr/lib/brave-browser
	done
	vinstall out/Release/vk_swiftshader_icd.json 644 usr/lib/brave-browser
	if [ "$build_option_qt6" ]; then
		vinstall out/Release/libqt6_shim.so 755 usr/lib/brave-browser
	fi
	vcopy "out/Release/*.bin" usr/lib/brave-browser
	vcopy "out/Release/*.pak" usr/lib/brave-browser
	vmkdir usr/lib/brave-browser/locales
	vcopy "out/Release/locales/*.pak" usr/lib/brave-browser/locales
	vcopy "out/Release/resources" usr/lib/brave-browser
	vinstall out/Release/icudtl.dat 644 usr/lib/brave-browser
	vinstall out/Release/version 644 usr/lib/brave-browser
	for size in 16 24 32 48 64 128 256; do
		target="brave/app/theme/brave/linux/product_logo_${size}.png"
		if [ ! -f "$target" ]; then
			target="brave/app/theme/default_100_percent/brave/linux/product_logo_${size}.png"
		fi
		vinstall "$target" 644 "usr/share/icons/hicolor/${size}x${size}/apps" brave-browser.png
	done
	vbin "${FILESDIR}/brave-browser.sh" brave-browser
	vinstall "${FILESDIR}/brave-browser.desktop" 644 usr/share/applications
	vman brave/chromium_src/chrome/app/resources/manpage.1.in brave-browser.1
	vsed -i \
		-e 's,\.config/@@PACKAGE,.config/BraveSoftware/Brave-Browser,g' \
		-e 's,\.cache/@@PACKAGE,.cache/BraveSoftware/Brave-Browser,g' \
		-e 's/@@MENUNAME/Brave Browser/g' \
		-e 's/@@PACKAGE/brave-browser/g' \
		"${DESTDIR}/usr/share/man/man1/brave-browser.1"
	vlicense brave/LICENSE
	vlicense LICENSE LICENSE.chromium
}

brave-browser-qt6_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - Qt6 integration"
	pkg_install() {
		vmove usr/lib/brave-browser/libqt6_shim.so
	}
}
